<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ERPProjectManager</AssemblyName>
    <RootNamespace>ERPProjectManager</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ERP Development Team</Authors>
    <Company>ERP Project</Company>
    <Product>ERP Project Manager Desktop</Product>
    <Description>Desktop application for managing ERP development with Git integration</Description>
    <Copyright>Copyright © 2025</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 for displaying web content -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2088.41" />

    <!-- LibGit2Sharp for Git operations -->
    <PackageReference Include="LibGit2Sharp" Version="0.27.2" />

    <!-- Newtonsoft.Json for JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
