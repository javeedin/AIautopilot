<Window x:Class="ERPProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ERP Project Manager - V1.1"
        Height="900"
        Width="1600"
        WindowState="Maximized"
        Background="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="10">
            <StackPanel Orientation="Horizontal">
                <!-- Navigation Buttons -->
                <Button x:Name="backButton"
                        Click="BackButton_Click"
                        ToolTip="Go Back"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="◀ Back" FontWeight="Medium"/>
                </Button>

                <Button x:Name="forwardButton"
                        Click="ForwardButton_Click"
                        ToolTip="Go Forward"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="Forward ▶" FontWeight="Medium"/>
                </Button>

                <Button x:Name="homeButton"
                        Click="HomeButton_Click"
                        ToolTip="Go to Dashboard"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="🏠 Home" FontWeight="Medium"/>
                </Button>

                <Button x:Name="reloadButton"
                        Click="ReloadButton_Click"
                        ToolTip="Reload Page"
                        Margin="0,0,20,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="🔄 Reload" FontWeight="Medium"/>
                </Button>

                <Separator Margin="0,0,20,0" Background="#475569"/>

                <!-- Git/App Buttons -->
                <Button x:Name="downloadButton"
                        Click="DownloadButton_Click"
                        ToolTip="Download latest code from GitHub to C:\javeed\Aiautopilot"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#10B981"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="⬇️ Download from GitHub" FontWeight="SemiBold"/>
                </Button>

                <Button x:Name="refreshButton"
                        Click="RefreshButton_Click"
                        ToolTip="Pull latest changes from Git"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="📥 Update from Git" FontWeight="SemiBold"/>
                </Button>

                <Button x:Name="openFolderButton"
                        Click="OpenFolderButton_Click"
                        ToolTip="Open project folder"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="📁 Open Folder" FontWeight="Medium"/>
                </Button>

                <Button x:Name="devToolsButton"
                        Click="DevToolsButton_Click"
                        ToolTip="Open DevTools (F12)"
                        Margin="0,0,5,0"
                        Padding="10,5"
                        Background="#334155"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="🔧 DevTools" FontWeight="Medium"/>
                </Button>

                <!-- Title -->
                <TextBlock Text="ERP Project Manager"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="30,0,5,0"/>

                <TextBlock Text="V1.1"
                           Foreground="#10B981"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0"/>

                <TextBlock Text="Desktop Application"
                           Foreground="#94A3B8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- WebView2 -->
        <Border Grid.Row="1" BorderThickness="0">
            <wv2:WebView2 x:Name="webView"
                          Source="about:blank"/>
        </Border>

        <!-- Status Bar -->
        <Border x:Name="statusBar"
                Grid.Row="2"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="10,5"
                Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:"
                           Foreground="#64748B"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="statusText"
                           Text="Initializing..."
                           Foreground="#0F172A"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
